{
  "name": "@salon-spot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "worker:dev": "nest start --watch --entryFile worker-main",
    "admin:grant": "pnpm run build && node dist/scripts/grant-admin.js",
    "professional:grant": "pnpm run build && node dist/scripts/grant-professional.js",
    "demo:seed": "pnpm run build && node dist/scripts/seed-demo.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/client": "6.19.0",
    "@salon-spot/contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "jest": "30.4.2",
    "prisma": "6.19.0",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
