{
  "name": "salon-spot",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "prisma:generate": "pnpm --filter @salon-spot/api run prisma:generate",
    "runtime:up": "docker compose --project-name salon-spot-runtime --env-file .env.runtime -f compose.runtime.yaml up --build -d",
    "runtime:down": "docker compose --project-name salon-spot-runtime --env-file .env.runtime -f compose.runtime.yaml down",
    "p1:mysql": "node scripts/p1/run-mysql-e2e.mjs",
    "p1:runtime-smoke": "node scripts/p1/runtime-smoke.mjs",
    "p1:backup-restore": "node scripts/p1/backup-restore-rehearsal.mjs",
    "p1:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  }
}
