{
  "name": "salon-spot",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "prisma:generate": "pnpm --filter @salon-spot/api run prisma:generate",
    "runtime:up": "docker compose --env-file .env.runtime -f compose.runtime.yaml up --build -d",
    "runtime:down": "docker compose --env-file .env.runtime -f compose.runtime.yaml down"
  }
}
