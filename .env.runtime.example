# Copy this to .env.runtime. Do not commit the resulting file.
MYSQL_DATABASE=salon_spot
MYSQL_USER=salon_spot
MYSQL_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
MYSQL_HOST_PORT=3307
WEB_HOST_PORT=8080
DATABASE_URL=mysql://salon_spot:replace-with-a-unique-database-password@mysql:3306/salon_spot
PORT=3000
WORKER_PORT=3001
WEB_ORIGIN=http://localhost:8080
NODE_ENV=production
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
REFRESH_TOKEN_PEPPER=replace-with-a-separate-random-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
MEDIA_UPLOAD_SECRET=replace-with-a-third-random-32-plus-character-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/v1
MEDIA_STORAGE_ROOT=/data/media
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_MAX_UPLOAD_BYTES=10000000
MEDIA_MAX_PIXEL_COUNT=40000000
SLOT_HOLD_TTL_SECONDS=600
HEALTH_DB_TIMEOUT_MS=3000
WORKER_TICK_INTERVAL_SECONDS=5
WORKER_STARTUP_GRACE_SECONDS=60
WORKER_STALE_AFTER_SECONDS=30
WORKER_WATCHDOG_INTERVAL_SECONDS=5
WORKER_SHUTDOWN_GRACE_SECONDS=20
